
# Application
SERVER_PORT=8080

# LLM configuration
# false means model integration is not enabled yet
RAG_MODEL_ENABLED=false
RAG_MODEL_BASE_URL=https://api.example.com/v1
RAG_MODEL_NAME=your-model-name
RAG_MODEL_API_KEY=replace-with-your-api-key

# PostgreSQL configuration
DB_URL=jdbc:postgresql://localhost:5432/rag
DB_USERNAME=rag_user
DB_PASSWORD=replace-with-your-database-password


SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
SILICONFLOW_CONNECT_TIMEOUT=3s
SILICONFLOW_READ_TIMEOUT=30s
SILICONFLOW_REQUESTS_PER_SECOND=2

# Day17 reranker configuration. Safe default: no external reranker call.
RAG_RERANK_PROVIDER=identity
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_API_KEY=
RAG_RERANK_CONNECT_TIMEOUT=3s
RAG_RERANK_READ_TIMEOUT=10s

# Optional real reranker test:
# Set RAG_RERANK_PROVIDER=siliconflow in your local .env.
# RAG_RERANK_API_KEY can reuse the same provider key as SILICONFLOW_API_KEY
# when that key has access to the selected reranker model.

# Default: run the complete RAG chain with a deterministic fake LLM.
RAG_LLM_PROVIDER=fake

# Optional real DeepSeek provider. Never commit a real key.
# RAG_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT=3s
DEEPSEEK_READ_TIMEOUT=30s
RAG_LLM_MAX_TOKENS=1200
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_CONTEXT_CHARS=12000

