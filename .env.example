
# Application
SERVER_PORT=8080

# LLM configuration
# false means model integration is not enabled yet
RAG_MODEL_ENABLED=false
RAG_MODEL_BASE_URL=https://api.example.com/v1
RAG_MODEL_NAME=your-model-name
RAG_MODEL_API_KEY=replace-with-your-api-key

# PostgreSQL configuration
DB_URL=jdbc:postgresql://localhost:5432/rag
DB_USERNAME=rag_user
DB_PASSWORD=replace-with-your-database-password


SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
SILICONFLOW_CONNECT_TIMEOUT=3s
SILICONFLOW_READ_TIMEOUT=30s
SILICONFLOW_REQUESTS_PER_SECOND=2
